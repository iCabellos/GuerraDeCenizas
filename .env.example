# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel del proyecto → Project Settings → API Keys
#
# Supabase tiene dos generaciones de claves y el código acepta las dos. Cambia el nombre,
# no el rol: `sb_publishable_…` sigue autenticando como `anon` y `sb_secret_…` como
# `service_role`, así que ni una política de RLS ni un test cambian.
#
#   Nueva (la que sugiere el panel)        Antigua (JWT `eyJ…`, sigue valiendo)
#   ───────────────────────────────        ───────────────────────────────────
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SECRET_KEY                    SUPABASE_SERVICE_ROLE_KEY
#
# Si defines las dos de un par, gana la nueva. `/api/health` dice cuál falta.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ⚠ SOLO en el servidor. Omite RLS: con esta clave se lee `game_states` entero y la
# niebla de guerra deja de existir. Nunca con prefijo NEXT_PUBLIC_, nunca en el cliente.
# Hay una regla estructural (tools/check-deps.mjs) que falla si aparece fuera de
# apps/web/lib/server/.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Reloj ───────────────────────────────────────────────────────────────────
# Secreto compartido con pg_cron. El mismo valor va en el vault de Supabase como
# `gdc_cron_secret` (ver supabase/migrations/0007_schedule.sql). Sin él,
# /api/cron/resolve-due sería una forma pública de forzar la resolución de cualquier
# partida vencida.
CRON_SECRET=cadena-larga-y-aleatoria
